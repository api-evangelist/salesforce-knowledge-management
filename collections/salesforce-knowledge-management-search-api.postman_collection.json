          "name": "Search Knowledge Articles",
          "request": {
            "name": "Search Knowledge Articles",
            "description": {
              "content": "Searches and retrieves knowledge articles visible to the specified channel (internal, public site, or community). Supports keyword search, filtering by article type, and category filters.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "support",
                "knowledgeArticles"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "channel",
                  "value": "App",
                  "description": "The channel to filter articles by"
                },
                {
                  "disabled": false,
                  "key": "categories",
                  "value": "<string>",
                  "description": "Map of category group to category value for filtering"
                },
                {
                  "disabled": false,
                  "key": "queryMethod",
                  "value": "<string>",
                  "description": "Method used to query the articles"
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "<string>",
                  "description": "Sort field for results"
                },
                {
                  "disabled": false,
                  "key": "order",
                  "value": "<string>",
                  "description": "Sort order"
                },
                {
                  "disabled": false,
                  "key": "pageSize",
                  "value": "25",
                  "description": "Number of articles per page"
                },
                {
                  "disabled": false,
                  "key": "pageNumber",
                  "value": "1",
                  "description": "Page number to retrieve"
                }
              ],
              "variable": [
                {
                  "description": "Your Salesforce instance identifier",
                  "type": "any",
                  "value": "{{instance}}",
                  "key": "instance"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
